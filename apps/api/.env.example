# Copy to .env and replace every value. Never commit .env.

# --- Database ---------------------------------------------------------------
DATABASE_URL=jdbc:postgresql://localhost:5432/ledgerforge
DATABASE_USERNAME=ledgerforge
DATABASE_PASSWORD=change-me-local-db-password

# --- Auth -------------------------------------------------------------------
# At least 32 random characters, e.g. `openssl rand -base64 48`
JWT_SECRET=replace-with-at-least-32-random-characters-xxxxxxxx
JWT_ISSUER=ledgerforge-api
JWT_AUDIENCE=ledgerforge-web

# --- Application ------------------------------------------------------------
APP_ENV=development
FRONTEND_ORIGIN=http://localhost:5173
SANDBOX_ENABLED=true
SEED_DEMO_DATA=true
# base64 of 32 random bytes (`openssl rand -base64 32`); required in production
WEBHOOK_ENCRYPTION_KEY=

# Optional: create an administrator on startup (any environment)
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
